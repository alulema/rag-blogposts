# Ejemplo de configuración local. NO commitear un .env real (repo PUBLICO → sin secretos).
# El runtime efimero inyecta PROJECT_ID / DEMO_SLOT; el resto tiene defaults seguros.
# Copiar a .env para desarrollo local:  cp .env.example .env

# Infra / demo (las inyecta el gateway en provision)
PROJECT_ID=rag-demo
DEMO_SLOT=demo01

# App (ingress interno, sin TLS: lo terminan ACA + gateway)
APP_HOST=0.0.0.0
APP_PORT=8080

# LLM local (Ollama) — $0 API, sin llamadas externas en prod
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:0.5b-instruct
MAX_OUTPUT_TOKENS=256

# Embeddings multilingues (384-d)
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store (Postgres + pgvector)
DB_DSN=postgresql://rag:rag@localhost:5432/rag

# Retrieval RAG
TOP_K=3
# Umbral de rehúso grounded. Calibrado (tools/calibrate_threshold, 2026-08-12) a CHUNK_TOKENS=600:
# separación limpia in/out (in_min≈0.44, out_max≈0.20, gap≈0.23) → 0.32 al medio del hueco.
# ⚠ Perf III bajó CHUNK_TOKENS a 400 → RECALIBRAR: re-ingesta + `python -m tools.calibrate_threshold`.
SIMILARITY_THRESHOLD=0.32

# Ingesta (build-time): chunking
CHUNK_TOKENS=400
CHUNK_OVERLAP=80
