# Ejemplo de configuración local. NO commitear un .env real (repo PUBLICO → sin secretos).
# El runtime efimero inyecta PROJECT_ID / DEMO_SLOT; el resto tiene defaults seguros.
# Copiar a .env para desarrollo local:  cp .env.example .env

# Infra / demo (las inyecta el gateway en provision)
PROJECT_ID=rag-demo
DEMO_SLOT=demo01

# App (ingress interno, sin TLS: lo terminan ACA + gateway)
APP_HOST=0.0.0.0
APP_PORT=8080

# LLM local (Ollama) — $0 API, sin llamadas externas en prod
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:0.5b-instruct
MAX_OUTPUT_TOKENS=256

# Embeddings multilingues (384-d)
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store (Postgres + pgvector)
DB_DSN=postgresql://rag:rag@localhost:5432/rag

# Retrieval RAG
TOP_K=3
# Umbral de rehúso grounded. 0.39 (calibrado con tools/calibrate_threshold contra negativos
# genéricos) dejó pasar en producción preguntas de React/Vue (top1 0.458-0.492): la batería
# original no incluía frameworks frontend "cercanos" al blog. Al ampliarla se vio que NO hay
# separación limpia: el piso in-corpus real (Levenshtein/JS) es 0.425, por debajo de Vue (0.492).
# 0.42 (2026-08-17) aprieta el margen sin refusar ningún tema real del blog; React/Vue quedan
# aceptados como fuga conocida (decisión: preservar Levenshtein > cerrar frameworks adyacentes).
SIMILARITY_THRESHOLD=0.42

# Ingesta (build-time): chunking
CHUNK_TOKENS=400
CHUNK_OVERLAP=80
